# ==========================================
# FASOINFO - CONFIGURATION D'ENVIRONNEMENT
# ==========================================

# 1. FRONTEND - VARIABLES PUBLIQUES CLIENT
# ------------------------------------------
# Firebase Authentication & Firestore Client SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary Client (nom du cloud public pour optimisation d'URL)
VITE_CLOUDINARY_CLOUD_NAME=

# 2. BACKEND - SECRETS ET CLÉS PRIVÉES
# ------------------------------------------
# Cloudinary API Credentials (pour uploads sécurisés et signatures d'assets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin SDK (compte de service pour vérification de tokens & custom claims)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Services d'infrastructure
GEMINI_API_KEY=
APP_URL=
